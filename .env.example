# ==========================================================
# Service Port Forwarding & Host Mapping Configuration
# Each service runs independently on its own dedicated port.
# If any port is busy on the host, override it here.
# ==========================================================
NOTEBUDDY_PORT=8080        # Website UI / Reverse Proxy
APPLICATION_PORT=8000      # Application Orchestration API
RETRIEVAL_PORT=8001        # Retrieval / Vector Search Service API
LLM_PORT=8002              # LLM Generation Service API
DATA_PORT=8003             # Data Ingestion & Repository Service API
CHROMA_PORT=8010           # ChromaDB Vector Database Host Port
OLLAMA_PORT=11434          # Ollama Local LLM Host Port

# ==========================================================
# Model & Service Connection Settings
# ==========================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
CHROMA_PATH=data/chroma
RETRIEVAL_TOP_K=4

