:root {
  --bg: #0e1110;
  --bg-soft: #121614;
  --panel: rgba(231, 236, 235, 0.065);
  --panel-strong: rgba(231, 236, 235, 0.1);
  --text: #e7eceb;
  --muted: rgba(231, 236, 235, 0.62);
  --muted-2: rgba(231, 236, 235, 0.42);
  --mint: #78fcd6;
  --mint-soft: #d0eee5;
  --mint-dark: #0e4d3e;
  --line: rgba(255, 255, 255, 0.1);
  --line-soft: rgba(255, 255, 255, 0.065);
  --shadow: 0 28px 90px rgba(0, 0, 0, 0.45);
  --radius: 18px;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 52% 18%, rgba(120, 252, 214, 0.035), transparent 25%),
    var(--bg);
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
}
button, textarea { font: inherit; }
a { color: inherit; text-decoration: none; }
.shell { width: min(1220px, calc(100% - 40px)); margin-inline: auto; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
.skip-link { position: fixed; left: 16px; top: -60px; z-index: 1000; padding: 12px 18px; color: #0d100f; background: var(--mint); border-radius: 8px; transition: top .2s; }
.skip-link:focus { top: 16px; }

.hero {
  min-height: 810px;
  margin-top: 24px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line-soft);
  border-radius: var(--radius);
  background: #101412;
}
.hero-grid, .cta-grid {
  position: absolute;
  inset: 0;
  opacity: .32;
  background-image:
    linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
  background-size: 36px 36px;
  mask-image: linear-gradient(to bottom right, transparent 2%, #000 44%, transparent 92%);
}
.hero-glow {
  position: absolute;
  width: 970px;
  height: 970px;
  top: -600px;
  right: -260px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 65%, #fff 0, var(--mint-soft) 18%, var(--mint) 35%, rgba(120,252,214,.22) 53%, transparent 69%);
  filter: blur(44px);
  opacity: .72;
}
.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(14,17,16,.24), transparent 55%), linear-gradient(0deg, rgba(14,17,16,.74), transparent 42%);
  pointer-events: none;
}
.site-header {
  position: relative;
  z-index: 20;
  height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
}
.brand { display: inline-flex; align-items: center; gap: 11px; font-weight: 650; letter-spacing: -.025em; }
.brand-mark {
  width: 31px; height: 31px; display: grid; place-items: center; border-radius: 9px;
  color: #0f1714; background: var(--mint); box-shadow: inset 0 0 0 1px rgba(255,255,255,.35);
}
.brand-mark svg { width: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.brand-mark.small { width: 28px; height: 28px; font-size: 12px; }
.desktop-nav { display: flex; align-items: center; gap: 4px; }
.desktop-nav a { padding: 9px 14px; border-radius: 999px; color: var(--muted); font-size: 14px; font-weight: 540; transition: .2s; }
.desktop-nav a:hover { color: var(--text); background: rgba(255,255,255,.055); }
.button {
  min-height: 43px; padding: 0 23px; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  border-radius: 999px; border: 1px solid transparent; font-size: 14px; font-weight: 640; transition: transform .2s, background .2s, border-color .2s;
}
.button:hover { transform: translateY(-2px); }
.button-light { color: #101412; background: var(--text); box-shadow: 0 0 0 4px rgba(255,255,255,.08); }
.button-light:hover { background: #fff; }
.button-ghost { color: var(--text); border-color: var(--line); background: rgba(255,255,255,.03); }
.button-ghost:hover { background: rgba(255,255,255,.08); }
.menu-button { display: none; width: 42px; height: 42px; border: 0; background: transparent; padding: 10px; }
.menu-button span { display: block; height: 1.5px; background: var(--text); margin: 5px 0; transition: .2s; }
.mobile-nav { display: none; }
.hero-copy { position: relative; z-index: 10; width: min(680px, 82%); margin: 92px auto 0; text-align: center; }
.eyebrow, .kicker { color: var(--mint); text-transform: uppercase; letter-spacing: .14em; font-size: 11px; font-weight: 700; }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid rgba(120,252,214,.17); border-radius: 999px; background: rgba(120,252,214,.055); }
.eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 12px var(--mint); }
.hero h1 { margin: 22px 0 16px; font-size: clamp(47px, 6vw, 76px); line-height: .98; letter-spacing: -.06em; font-weight: 610; }
.hero h1 span { color: var(--mint-soft); }
.hero-copy > p { width: min(590px, 100%); margin: 0 auto; color: var(--muted); font-size: 17px; line-height: 1.65; }
.hero-actions { display: flex; justify-content: center; gap: 12px; margin-top: 31px; }
.status-pill { position: absolute; z-index: 10; bottom: 38px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 8px 13px; border-radius: 999px; border: 1px solid var(--line); background: rgba(11,14,13,.62); backdrop-filter: blur(12px); color: var(--muted); font-size: 12px; white-space: nowrap; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: #69e8a6; box-shadow: 0 0 12px #69e8a6; }

.assistant-wrap { position: relative; z-index: 12; margin-top: -166px; padding: 0 30px; }
.assistant-frame { position: relative; padding: 8px; border: 1px solid rgba(208,238,229,.42); border-radius: 18px; background: rgba(208,238,229,.42); box-shadow: var(--shadow); }
.app-topbar { height: 52px; padding: 0 17px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-radius: 11px 11px 0 0; background: #171b19; border-bottom: 1px solid var(--line); }
.window-dots { display: flex; gap: 6px; }.window-dots span { width: 8px; height: 8px; border-radius: 50%; background: #515754; }.window-dots span:nth-child(2){opacity:.7}.window-dots span:nth-child(3){opacity:.45}
.app-title { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; font-weight: 600; }
.mini-mark { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; color: #12231d; background: var(--mint); font-size: 10px; }
.connection-state { justify-self: end; display: flex; align-items: center; gap: 7px; padding:6px 8px; color: var(--muted-2); border:0;border-radius:7px;background:transparent;font-size: 11px;cursor:pointer; }.connection-state:hover{background:rgba(255,255,255,.05);color:var(--text)}.connection-state span { width: 6px; height: 6px; border-radius: 50%; background: #69e8a6; }.connection-state b{font-weight:500}.connection-state.degraded span{background:#f0aa70;box-shadow:0 0 10px rgba(240,170,112,.5)}
.system-popover{position:absolute;z-index:30;top:53px;right:16px;width:310px;padding:14px;border:1px solid var(--line);border-radius:12px;background:rgba(18,22,20,.98);box-shadow:0 20px 60px rgba(0,0,0,.45);backdrop-filter:blur(18px)}.popover-heading{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;border-bottom:1px solid var(--line)}.popover-heading small,.popover-heading strong{display:block}.popover-heading small{color:var(--muted-2);font-size:8px;text-transform:uppercase;letter-spacing:.12em}.popover-heading strong{margin-top:3px;font-size:12px}.popover-heading button{width:29px;height:29px;color:var(--muted);border:1px solid var(--line);border-radius:7px;background:transparent;cursor:pointer}.service-status-list{display:grid;gap:7px;margin-top:12px}.service-status-row{display:grid;grid-template-columns:8px 1fr;gap:9px;align-items:start;padding:8px;border-radius:8px;background:rgba(255,255,255,.025)}.service-status-row>i{width:7px;height:7px;margin-top:3px;border-radius:50%;background:#69e8a6}.service-status-row.unavailable>i{background:#ee9277}.service-status-row strong,.service-status-row small{display:block}.service-status-row strong{font-size:10px;text-transform:capitalize}.service-status-row small{margin-top:3px;color:var(--muted-2);font-size:8px;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.assistant-app { min-height: 610px; display: grid; grid-template-columns: 245px 1fr; overflow: hidden; border-radius: 0 0 11px 11px; background: #111513; }
.source-sidebar { padding: 24px 17px 17px; border-right: 1px solid var(--line); display: flex; flex-direction: column; }
.knowledge-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:10px}.knowledge-heading>span{padding:4px 6px;border-radius:5px;color:var(--muted-2);background:rgba(255,255,255,.04);font-size:8px;white-space:nowrap}
.sidebar-label, .overline { margin: 0 0 5px; color: var(--muted-2); text-transform: uppercase; letter-spacing: .12em; font-size: 9px; font-weight: 700; }
.source-sidebar h2, .chat-heading h2 { margin: 0; font-size: 17px; letter-spacing: -.02em; }
.upload-button{width:100%;height:37px;margin-top:17px;color:var(--mint);border:1px dashed rgba(120,252,214,.24);border-radius:8px;background:rgba(120,252,214,.045);font-size:10px;font-weight:650;cursor:pointer}.upload-button:hover{background:rgba(120,252,214,.09)}.upload-button span{margin-right:4px}.upload-button:disabled{opacity:.5;cursor:wait}.upload-status{min-height:13px;margin:6px 2px 0;color:var(--muted-2);font-size:8px;line-height:1.4}.upload-status.error{color:#ee9277}.upload-status.success{color:var(--mint)}
.source-list { display: grid; gap: 6px; margin-top: 8px; max-height:275px;overflow:auto;scrollbar-width:thin; }
.knowledge-empty{min-height:145px;padding:20px 10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:1px dashed var(--line);border-radius:9px}.knowledge-empty>span{width:32px;height:32px;display:grid;place-items:center;margin-bottom:10px;border-radius:8px;color:var(--mint);background:rgba(120,252,214,.07)}.knowledge-empty strong{font-size:10px}.knowledge-empty small{margin-top:5px;color:var(--muted-2);font-size:8px}
.source-item { width: 100%; min-height: 56px; display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 10px; padding: 8px; color: var(--text); text-align: left; border: 1px solid transparent; border-radius: 9px; background: transparent; cursor: pointer; }
.source-item:hover, .source-item.active { border-color: var(--line); background: rgba(255,255,255,.045); }
.source-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 8px; color: var(--mint); background: rgba(120,252,214,.09); border: 1px solid rgba(120,252,214,.12); font-size: 11px; font-weight: 700; }
.source-item strong, .source-item small { display: block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.source-item strong { max-width:115px;font-size: 10px; font-weight: 600; }.source-item small { margin-top: 3px; color: var(--muted-2); font-size: 8px; }.source-check { color: var(--mint); font-size: 11px; }
.index-card { margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: 9px; background: rgba(120,252,214,.055); border: 1px solid rgba(120,252,214,.12); }.pulse-icon { color: var(--mint); }.index-card strong, .index-card small { display: block; }.index-card strong { font-size: 11px; }.index-card small { margin-top: 3px; color: var(--muted-2); font-size: 9px; }
.chat-panel { min-width: 0; display: flex; flex-direction: column; }
.chat-heading { height: 76px; padding: 0 24px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
.chat-actions{display:flex;align-items:center;gap:9px}.mode-switch{display:flex;padding:3px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.025)}.mode-switch button{height:27px;padding:0 9px;color:var(--muted-2);border:0;border-radius:5px;background:transparent;font-size:9px;cursor:pointer}.mode-switch button.active{color:#102019;background:var(--mint);font-weight:700}
.mobile-knowledge-bar{display:none}
.icon-button { width: 34px; height: 34px; color: var(--muted); border: 1px solid var(--line); border-radius: 9px; background: transparent; cursor: pointer; }.icon-button:hover { color: var(--text); background: var(--panel); }
.messages { flex: 1; padding: 25px 28px; overflow-y: auto; min-height: 335px; max-height: 390px; }
.message { display: grid; grid-template-columns: 34px 1fr; gap: 12px; margin-bottom: 23px; animation: messageIn .35s ease both; }
@keyframes messageIn { from { opacity:0; transform:translateY(7px); } }
.avatar { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 9px; font-size: 9px; font-weight: 700; }.user-avatar { color: var(--muted); background: var(--panel-strong); }.assistant-avatar { color: #102119; background: var(--mint); }
.message-name { color: var(--muted-2); font-size: 10px; font-weight: 700; }.message-content p { margin: 6px 0 0; max-width: 720px; color: rgba(231,236,235,.85); font-size: 13px; line-height: 1.68; }.user-message .message-content p { color: var(--text); }
.citation-chip { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; padding: 7px 10px; color: var(--mint); border: 1px solid rgba(120,252,214,.18); border-radius: 7px; background: rgba(120,252,214,.055); font-size: 10px; cursor: pointer; }
.source-preview{max-width:700px;margin-top:9px;padding:11px 12px;border-left:2px solid var(--mint);border-radius:0 8px 8px 0;background:rgba(120,252,214,.045);animation:messageIn .25s ease}.source-preview strong,.source-preview small{display:block}.source-preview strong{color:var(--mint);font-size:9px}.source-preview p{margin:6px 0!important;color:var(--muted)!important;font-size:10px!important;line-height:1.55!important}.source-preview small{color:var(--muted-2);font-size:8px}
.orchestration-trace{display:flex;align-items:center;gap:6px;margin-top:10px;color:var(--muted-2);font-size:8px;text-transform:capitalize}.orchestration-trace span{color:var(--mint)}
.comparison-message{display:block;margin:0 0 24px}.comparison-label{margin:0 0 9px;color:var(--muted-2);font-size:9px;text-transform:uppercase;letter-spacing:.12em}.comparison-question{margin:0 0 13px;font-size:13px}.comparison-grid-live{display:grid;grid-template-columns:1fr 1fr;gap:10px}.answer-variant{min-height:150px;padding:14px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.025)}.answer-variant.grounded{border-color:rgba(120,252,214,.2);background:rgba(120,252,214,.045)}.answer-variant>small{color:var(--muted-2);text-transform:uppercase;letter-spacing:.1em;font-size:8px}.answer-variant>p{margin:12px 0;color:rgba(231,236,235,.82);font-size:11px;line-height:1.55}.answer-variant .citation-chip{margin-top:5px;white-space:normal;text-align:left}.variant-status{display:inline-flex;padding:4px 6px;border-radius:5px;color:#eab9a8;background:rgba(221,132,101,.08);font-size:8px}.grounded .variant-status{color:var(--mint);background:rgba(120,252,214,.08)}
.composer { margin: 0 24px; padding: 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 12px; background: rgba(255,255,255,.035); transition: border-color .2s, box-shadow .2s; }.composer:focus-within { border-color: rgba(120,252,214,.4); box-shadow: 0 0 0 3px rgba(120,252,214,.06); }
.composer textarea { width: 100%; max-height: 110px; resize: none; color: var(--text); border: 0; outline: 0; background: transparent; font-size: 13px; line-height: 1.5; }.composer textarea::placeholder { color: var(--muted-2); }
.composer-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }.mode-label { color: var(--muted-2); font-size: 10px; }.mode-label span { color: var(--mint); }
.send-button { height: 33px; padding: 0 13px; display: flex; align-items: center; gap: 7px; color: #102019; border: 0; border-radius: 8px; background: var(--mint); font-size: 10px; font-weight: 700; cursor: pointer; }.send-button:hover { background: #9affdf; }.send-button:disabled { opacity: .55; cursor: wait; }.send-button svg { width: 14px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; }
.demo-note { margin: 9px 24px 16px; color: var(--muted-2); text-align: center; font-size: 9px; }
.typing { display: inline-flex; gap: 4px; padding: 5px 0; }.typing i { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); animation: bounce 1s infinite; }.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}@keyframes bounce{50%{transform:translateY(-4px);opacity:.45}}

.material-strip { padding: 78px 30px 52px; text-align: center; }.material-strip > p { color: var(--muted-2); font-size: 12px; }.material-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; margin-top: 26px; }.material-grid div { display:flex; align-items:center; justify-content:center; gap:10px; color:var(--muted); font-size:13px; font-weight:600; }.material-grid span { color:var(--mint); font-size:18px; }
.section, .architecture-section, .journey-section, .faq-section { padding-top: 90px; }
.section-heading { max-width: 650px; margin: 0 auto 45px; text-align: center; }.section-heading h2 { margin: 13px 0 15px; font-size: clamp(37px, 5vw, 55px); line-height: 1.04; letter-spacing: -.055em; font-weight: 580; }.section-heading p { width: min(570px,100%); margin:0 auto; color:var(--muted); font-size:15px; line-height:1.65; }
.bento-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; padding:0 20px; }.bento-card { min-height:425px; position:relative; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025)); }.bento-wide { grid-column:span 1; }.card-copy { position:relative; z-index:2; padding:25px 26px; }.card-copy h3 { margin:0; font-size:17px; font-weight:570; }.card-copy p { margin:6px 0 0; color:var(--muted); font-size:14px; line-height:1.55; }
.grounding-visual { padding:20px 25px; }.query-node { width:70%; margin:10px auto 0; padding:13px 15px; display:flex; align-items:center; gap:10px; border:1px solid rgba(120,252,214,.22); border-radius:10px; background:rgba(120,252,214,.07); color:var(--text); font-size:12px; }.query-node span { width:25px;height:25px;display:grid;place-items:center;border-radius:7px;background:var(--mint);color:#112019;font-weight:700; }.connector-lines { height:48px; width:70%; margin:auto; display:flex;justify-content:space-around; }.connector-lines i { width:1px;background:linear-gradient(var(--mint),rgba(120,252,214,.08)); }.context-row { display:grid;grid-template-columns:repeat(3,1fr);gap:10px; }.context-row div { min-height:110px;padding:14px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.03); }.context-row span { width:26px;height:26px;display:grid;place-items:center;border-radius:7px;background:rgba(120,252,214,.09);color:var(--mint);font-size:10px; }.context-row small,.context-row strong { display:block; }.context-row small{margin-top:15px;color:var(--muted-2);font-size:9px}.context-row strong{margin-top:3px;font-size:11px}
.citation-visual { margin:26px; padding:22px; border:1px solid var(--line); border-radius:13px; background:#111513; }.citation-visual p { margin:0 0 22px; font-size:16px;line-height:1.5; }.citation-visual span { display:flex;align-items:center;gap:8px;width:max-content;max-width:100%;margin:8px 0;padding:8px 11px;border:1px solid rgba(120,252,214,.18);border-radius:8px;color:var(--mint);background:rgba(120,252,214,.055);font-size:10px; }.citation-visual i { width:20px;height:20px;display:grid;place-items:center;border-radius:5px;background:rgba(120,252,214,.12);font-style:normal;font-size:9px; }
.pages-visual { height:270px; position:relative; margin:10px 28px; }.page-card { position:absolute;width:190px;height:230px;padding:18px;border:1px solid var(--line);border-radius:10px;background:#171b19;box-shadow:0 18px 40px rgba(0,0,0,.28); }.page-card span{color:var(--mint);font-size:10px}.page-card b{display:block;margin:32px 0 25px;font-size:14px}.page-card i{display:block;height:5px;margin:9px 0;border-radius:3px;background:rgba(255,255,255,.09)}.page-card i:nth-of-type(2){width:80%}.page-card i:nth-of-type(3){width:62%}.p1{left:4%;top:22px;transform:rotate(-8deg)}.p2{left:32%;top:3px;z-index:2}.p3{right:4%;top:22px;transform:rotate(8deg)}
.local-visual { height:265px;display:grid;place-items:center;position:relative; }.local-orbit { width:150px;height:150px;display:grid;place-items:center;border:1px solid rgba(120,252,214,.14);border-radius:50%;position:relative;box-shadow:0 0 80px rgba(120,252,214,.07); }.local-orbit::before { content:"";position:absolute;width:100px;height:100px;border:1px dashed rgba(120,252,214,.18);border-radius:50%; }.local-orbit span { width:58px;height:58px;display:grid;place-items:center;border-radius:16px;color:#102019;background:var(--mint);font-size:25px; }.local-orbit i { position:absolute;width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 14px var(--mint); }.local-orbit i:first-of-type{top:12px;left:30px}.local-orbit i:last-of-type{bottom:23px;right:14px}.local-label { position:absolute;bottom:9px;text-align:center}.local-label strong,.local-label small{display:block}.local-label strong{font-size:12px}.local-label small{margin-top:5px;color:var(--muted-2);font-size:9px}
.compare-visual { display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:24px; }.compare-visual > div { min-height:180px;padding:17px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025); }.compare-visual .rag-side{border-color:rgba(120,252,214,.2);background:rgba(120,252,214,.045)}.compare-visual small{color:var(--muted-2);font-size:9px;text-transform:uppercase;letter-spacing:.1em}.compare-visual p{margin:32px 0;font-size:14px}.compare-visual span{padding:6px 8px;border-radius:6px;font-size:9px}.warning{color:#eab9a8;background:rgba(221,132,101,.08)}.success{color:var(--mint);background:rgba(120,252,214,.08)}
.services-visual { min-height:270px;padding:40px 24px;display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap}.service-box{width:104px;height:112px;padding:13px;border:1px solid var(--line);border-radius:11px;background:#151917;display:flex;flex-direction:column;justify-content:space-between}.service-box.active{border-color:rgba(120,252,214,.27);box-shadow:0 0 35px rgba(120,252,214,.06)}.service-box span{color:var(--mint);font-size:9px}.service-box strong{font-size:11px}.service-box small{color:var(--muted-2);font-size:9px}.services-visual>i{color:var(--mint);font-style:normal}.down-arrow{display:none}

.architecture-section { position:relative; overflow:hidden; margin-top:80px; padding:110px 35px 90px; border:1px solid var(--line-soft);border-radius:var(--radius);background:rgba(255,255,255,.018)}.architecture-glow{position:absolute;width:460px;height:290px;left:50%;top:-190px;transform:translateX(-50%);background:var(--mint);filter:blur(160px);opacity:.13}.pipeline{position:relative;display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:12px}.pipeline article{min-height:210px;padding:18px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.03)}.pipeline article>span{color:var(--muted-2);font-size:9px}.pipeline-icon{width:43px;height:43px;margin:24px 0 18px;display:grid;place-items:center;border-radius:11px;color:#112119;background:var(--mint);font-size:18px}.pipeline h3{margin:0;font-size:15px}.pipeline p{margin:7px 0 0;color:var(--muted);font-size:11px;line-height:1.55}.pipeline-arrow{color:var(--mint)}
.journey-section{padding-inline:20px}.journey-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.journey-card{min-height:300px;padding:19px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(155deg,rgba(255,255,255,.055),rgba(255,255,255,.018));display:flex;flex-direction:column}.journey-card>span{color:var(--muted-2);font-size:9px;text-transform:uppercase;letter-spacing:.1em}.journey-card>b{width:39px;height:39px;margin:31px 0;display:grid;place-items:center;border-radius:10px;color:#102019;background:var(--mint);font-size:13px}.journey-card h3{margin:0;font-size:15px}.journey-card p{margin:9px 0;color:var(--muted);font-size:11px;line-height:1.6}.journey-card small{margin-top:auto;color:var(--mint);font-size:9px}.journey-card.current{border-color:rgba(120,252,214,.3);background:linear-gradient(155deg,rgba(120,252,214,.1),rgba(120,252,214,.02))}.journey-card.current>b{color:var(--mint);border:1px solid rgba(120,252,214,.25);background:rgba(120,252,214,.08)}
.statement{padding:150px 80px;text-align:center}.statement-mark{color:var(--mint);font-family:Georgia,serif;font-size:90px;line-height:.55;opacity:.8}.statement blockquote{max-width:980px;margin:20px auto 36px;font-size:clamp(26px,4vw,49px);line-height:1.2;letter-spacing:-.045em;font-weight:540}.statement-byline{display:flex;align-items:center;justify-content:center;gap:11px;text-align:left}.statement-byline strong,.statement-byline small{display:block}.statement-byline strong{font-size:12px}.statement-byline small{margin-top:3px;color:var(--muted-2);font-size:10px}
.faq-section{padding-bottom:130px}.faq-list{width:min(680px,100%);margin:auto;display:grid;gap:10px}.faq-item{border:1px solid var(--line);border-radius:11px;background:var(--panel);overflow:hidden}.faq-item button{width:100%;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;color:var(--text);text-align:left;border:0;background:transparent;cursor:pointer;font-size:14px;font-weight:570}.faq-item button i{font-style:normal;color:var(--muted);font-size:20px;transition:transform .25s}.faq-item.open button i{transform:rotate(45deg)}.faq-answer{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s}.faq-answer p{overflow:hidden;margin:0;padding:0 20px;color:var(--muted);font-size:12px;line-height:1.7;transition:padding .35s}.faq-item.open .faq-answer{grid-template-rows:1fr}.faq-item.open .faq-answer p{padding:0 20px 19px}
.final-cta{min-height:600px;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:1px solid var(--line-soft);border-radius:var(--radius)}.cta-grid{mask-image:linear-gradient(#000,transparent 95%)}.cta-glow{position:absolute;width:900px;height:420px;top:-315px;border-radius:50%;background:radial-gradient(ellipse,var(--mint),rgba(120,252,214,.25) 35%,transparent 70%);filter:blur(30px)}.final-cta>*:not(.cta-grid,.cta-glow){position:relative;z-index:2}.final-cta h2{margin:14px 0;font-size:clamp(42px,6vw,68px);line-height:1.02;letter-spacing:-.06em;font-weight:590}.final-cta p{max-width:520px;margin:0 0 28px;color:var(--muted);font-size:15px;line-height:1.6}
.footer{padding:75px 30px 25px;display:grid;grid-template-columns:1fr 1.6fr;gap:60px}.footer-brand p{margin:18px 0;color:var(--muted);font-size:12px}.footer-links{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.footer-links div{display:flex;flex-direction:column;gap:10px}.footer-links strong{margin-bottom:5px;color:var(--muted-2);font-size:10px}.footer-links a,.footer-links span{font-size:11px;color:var(--muted)}.footer-links a:hover{color:var(--mint)}.footer-bottom{grid-column:1/-1;padding-top:25px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--muted-2);font-size:9px}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}.reveal.visible{opacity:1;transform:none}

@media (max-width: 900px){
  .desktop-nav,.header-cta{display:none}.menu-button{display:block}.mobile-nav{position:absolute;z-index:19;top:68px;left:20px;right:20px;padding:14px;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:12px;background:rgba(15,18,17,.96);backdrop-filter:blur(16px);opacity:0;pointer-events:none;transform:translateY(-8px);transition:.2s}.mobile-nav.open{opacity:1;pointer-events:auto;transform:none}.mobile-nav a{padding:12px;color:var(--muted);border-bottom:1px solid var(--line-soft)}
  .hero{min-height:720px}.hero-copy{margin-top:78px}.assistant-wrap{margin-top:-110px;padding:0 12px}.assistant-app{grid-template-columns:1fr}.source-sidebar{display:none}.app-topbar{grid-template-columns:1fr auto}.window-dots{display:none}.app-title{justify-self:start}.mobile-knowledge-bar{min-height:43px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(255,255,255,.018)}.mobile-knowledge-bar>div{display:flex;align-items:center;gap:7px}.mobile-knowledge-bar b{color:var(--muted);font-size:9px;font-weight:500}.mobile-knowledge-bar button{height:27px;padding:0 9px;color:var(--mint);border:1px solid rgba(120,252,214,.17);border-radius:6px;background:rgba(120,252,214,.045);font-size:9px}.material-grid{grid-template-columns:repeat(2,1fr)}
  .journey-grid{grid-template-columns:repeat(2,1fr)}.journey-card:last-child{grid-column:span 2}.pipeline{grid-template-columns:1fr 1fr;gap:12px}.pipeline-arrow{display:none}.statement{padding:110px 30px}.footer{grid-template-columns:1fr}.footer-links{grid-template-columns:repeat(3,1fr)}
}
@media (max-width: 620px){
  .shell{width:min(100% - 24px,1220px)}.hero{min-height:660px;margin-top:12px}.site-header{height:68px;padding:0 17px}.brand{font-size:13px}.brand-mark{width:28px;height:28px}.hero-copy{width:92%;margin-top:67px}.hero h1{font-size:45px}.hero-copy>p{font-size:14px}.hero-actions{flex-direction:column;align-items:center}.hero-actions .button{width:210px}.status-pill{bottom:25px}
  .assistant-wrap{width:100%;margin-top:-75px;padding:0 8px}.assistant-frame{padding:5px}.app-topbar{padding:0 12px}.connection-state{font-size:9px}.connection-state b{display:none}.system-popover{right:5px;left:5px;width:auto}.assistant-app{min-height:570px}.chat-heading{height:auto;min-height:88px;padding:12px 16px;align-items:flex-start}.chat-actions{flex-direction:column-reverse;align-items:flex-end;gap:6px}.mode-switch button{padding:0 7px}.messages{padding:20px 16px;min-height:320px}.comparison-grid-live{grid-template-columns:1fr}.composer{margin:0 12px}.demo-note{margin-inline:12px}.send-button span{display:none}
  .material-strip{padding:60px 10px 35px}.material-grid{gap:12px}.material-grid div{font-size:11px}.section,.architecture-section,.journey-section,.faq-section{padding-top:70px}.section-heading{margin-bottom:32px}.section-heading h2{font-size:38px}.bento-grid{grid-template-columns:1fr;padding:0}.bento-card{min-height:390px}.context-row div{padding:10px}.context-row strong{font-size:9px}.page-card{width:145px}.p2{left:28%}.services-visual{padding-inline:12px}.service-box{width:90px}.architecture-section{padding:80px 17px 60px;margin-top:55px}.pipeline{grid-template-columns:1fr}.journey-section{padding-inline:0}.journey-grid{grid-template-columns:1fr}.journey-card:last-child{grid-column:auto}.journey-card{min-height:240px}.journey-card>b{margin:24px 0}.statement{padding:95px 15px}.statement blockquote{font-size:28px}.faq-section{padding-bottom:90px}.final-cta{min-height:520px;padding-inline:18px}.final-cta h2{font-size:43px}.footer{padding:60px 10px 20px;grid-template-columns:1fr}.footer-links{grid-template-columns:1fr 1fr}.footer-bottom{flex-direction:column;gap:8px}
}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
